pipeline {  
    agent any  
        stages {  
       	    stage("Developer 2 ") {  
           	    steps {  
              	    echo "cloning repository" 
              	    echo "repo cloned successfully"  
              	    }  
         	    } 
      
        }stage("Jenkins pushed ") {  
           	    steps {  
              	    echo "cloning repository" 
              	    echo "repo cloned successfully"  
              	    }  
         	    } 



}
